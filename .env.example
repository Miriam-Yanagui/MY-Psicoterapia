# Public Supabase project configuration (safe for browser use).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# Mercado Pago public key is embedded in the browser bundle.
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=

# Server-only Mercado Pago credential. Never expose with NEXT_PUBLIC_.
MERCADO_PAGO_ACCESS_TOKEN=

# Server-only secret generated in Mercado Pago's Webhooks configuration.
MERCADO_PAGO_WEBHOOK_SECRET=

# Server-only transactional email. Keep these values out of NEXT_PUBLIC_*.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Psico. Miriam Yanagui <hola@mypsicoterapia.com>"
RESEND_REPLY_TO_EMAIL=hola@mypsicoterapia.com
MIRIAM_NOTIFICATION_EMAIL=hola@mypsicoterapia.com

# Protects the retry endpoint used by a scheduler.
CRON_SECRET=

# Server-only Google Calendar OAuth connection for the professional account.
# Add the exact callback URL below to the OAuth client's authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://www.mypsicoterapia.com/api/google/callback
MIRIAM_GOOGLE_EMAIL=
